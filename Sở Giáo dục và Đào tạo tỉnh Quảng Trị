name: Cap nhat du lieu
on:
  schedule:
    - cron: '*/30 * * * *'
  workflow_dispatch:
permissions:
  contents: write
jobs:
  capnhat:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install python-docx
      - run: python dong_bo.py
        env:
          DRIVE_FILE_ID: ${{ secrets.DRIVE_FILE_ID }}
      - run: |
          git config user.name "cap-nhat-tu-dong"
          git config user.email "actions@users.noreply.github.com"
          git add data.json
          git commit -m "Cap nhat du lieu" || exit 0
          git push
